{
  "name": "deckforge",
  "version": "1.0.0",
  "description": "Virtual stream deck with plugin system",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .\"",
    "electron:build": "npm run build && electron-builder",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "@serialport/parser-readline": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.deckforge.app",
    "productName": "DeckForge",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
